// ---------- DASHBOARD ----------
function computeGivenLocal(type, matchFn){
  let given=0;
  STATE.students.forEach(s=>(s.items||[]).forEach(it=>{ if(it.status==='Completed' && it.type===type && matchFn(it)) given++; }));
  return given;
}
function computeDashboardLocal(){
  const totalStudents = STATE.students.length;
  const totalBooks = STATE.books.length;
  const totalUniformItems = STATE.uniforms.length;
  const totalBookStock = STATE.bookStock.reduce((a,b)=>a+(b.stock||0),0);
  const totalUniformStock = STATE.uniformStock.reduce((a,b)=>a+(b.stock||0),0);
  let pendingBookAmount=0, pendingUniformAmount=0, givenBooks=0, givenUniforms=0;
  STATE.students.forEach(s=>(s.items||[]).forEach(it=>{
    const amt = Number(it.price)||0;
    if(it.category){ if(it.status==='Pending') pendingUniformAmount+=amt; else givenUniforms++; }
    else { if(it.status==='Pending') pendingBookAmount+=amt; else givenBooks++; }
  }));
  return { totalStudents, totalBooks, totalUniformItems, totalBookStock, totalUniformStock, pendingBookAmount, pendingUniformAmount, remainingBookStock: totalBookStock-givenBooks, remainingUniformStock: totalUniformStock-givenUniforms };
}
function renderDashboard(){
  const d = computeDashboardLocal();
  const cards = [
    ['Total Students', d.totalStudents], ['Total Books', d.totalBooks], ['Total Uniform Items', d.totalUniformItems],
    ['Total Book Stock', d.totalBookStock], ['Total Uniform Stock', d.totalUniformStock],
    ['Pending Book Amount', '₹'+d.pendingBookAmount], ['Pending Uniform Amount', '₹'+d.pendingUniformAmount],
    ['Remaining Book Stock', d.remainingBookStock], ['Remaining Uniform Stock', d.remainingUniformStock]
  ];
  document.getElementById('dashCards').innerHTML = cards.map((c,i)=>`<div class="card${i%2?' pink':''}"><div class="label">${c[0]}</div><div class="value">${c[1]}</div></div>`).join('');
}

