function closeStudentForm(){ document.getElementById('studentFormPanel').classList.add('hidden'); }
function editStudent(id){
  const s = STATE.students.find(x=>x.id===id); if(!s) return;
  editingStudentId = id;
  document.getElementById('studentFormTitle').textContent = 'Edit Student';
  document.getElementById('sf-name').value=s.name; document.getElementById('sf-mobile').value=s.mobile; document.getElementById('sf-class').value=s.className;
  document.getElementById('sf-err').textContent='';
  document.getElementById('studentFormPanel').classList.remove('hidden');
  document.getElementById('studentProfilePanel').classList.add('hidden');
}
function saveStudent(){
  const name = document.getElementById('sf-name').value.trim();
  const mobile = document.getElementById('sf-mobile').value.trim();
  const className = document.getElementById('sf-class').value;
  const errEl = document.getElementById('sf-err');
  if(!name || !mobile || !className){ errEl.textContent='All fields are required'; return; }
  if(!/^\d{7,15}$/.test(mobile)){ errEl.textContent='Enter a valid mobile number'; return; }
  const doSave = async ()=>{
    try{
      if(editingStudentId) await api('/api/students/'+editingStudentId,'PUT',{name,mobile,className});
      else await api('/api/students','POST',{name,mobile,className});
      showToast('Saved successfully');
      closeStudentForm();
      await refreshAll();
    }catch(e){ errEl.textContent = e.message; }
  };
  if(editingStudentId) askConfirm('Are you sure you want to save these changes?', doSave);
  else doSave();
}
function viewStudent(id){
  const s = STATE.students.find(x=>x.id===id); if(!s) return;
  document.getElementById('pv-name').textContent = s.name;
  document.getElementById('pv-mobile').textContent = s.mobile;
  document.getElementById('pv-class').textContent = s.className;
  document.getElementById('studentProfilePanel').classList.remove('hidden');
  document.getElementById('studentFormPanel').classList.add('hidden');
}
function closeProfile(){ document.getElementById('studentProfilePanel').classList.add('hidden'); }
function deleteStudent(id){
  askConfirm('Are you sure you want to delete this student?', async ()=>{
    try{ await api('/api/students/'+id,'DELETE'); showToast('Student deleted'); await refreshAll(); }
    catch(e){ showToast(e.message); }
  });
}

// ---------- ITEM TOTALS HELPER ----------
function itemsTotals(items){
  let pending=0, completed=0;
  items.forEach(it=>{ if(it.status==='Pending') pending+=Number(it.price)||0; else completed+=Number(it.price)||0; });
  return { pending, completed, total: pending+completed, pendingCount: items.filter(i=>i.status==='Pending').length, completedCount: items.filter(i=>i.status==='Completed').length };
}

// ---------- ASSIGN ITEMS TO STUDENTS ----------
function renderAsTable(){
  const q = (document.getElementById('asSearch').value||'').toLowerCase();
  const list = STATE.students.filter(s => !q || s.name.toLowerCase().includes(q) || s.mobile.includes(q));
  document.getElementById('asTable').innerHTML = list.map(s=>`
    <tr><td>${esc(s.name)}</td><td>${esc(s.mobile)}</td><td>${esc(s.className)}</td>
    <td><button class="btn small outline" onclick="assignView('${s.id}')">View</button></td>
    <td><button class="btn small" onclick="openEditChoice('${s.id}')">Edit</button></td></tr>`).join('') || '<tr><td colspan="5" style="color:var(--muted)">No students found</td></tr>';
}
document.getElementById('asSearch').addEventListener('input', renderAsTable);

function assignView(id){
  const s = STATE.students.find(x=>x.id===id); if(!s) return;
  const items = s.items||[];
  const t = itemsTotals(items);
  const rows = items.map(it=>{
    const label = it.category ? `${esc(it.name)} (Size ${esc(it.size)})` : esc(it.name);
    return `<div class="payment-item-row"><span>${label}</span><span><span class="badge ${it.status.toLowerCase()}">${it.status}</span> &nbsp;₹${it.price} ${it.status==='Pending'?`<button class="btn small" style="margin-left:8px" onclick="markCompletedInView('${s.id}','${it.id}')">Mark Completed</button>`:''}</span></div>`;
  }).join('') || '<p style="color:var(--muted)">No items assigned yet</p>';
  const body = `<div class="profile-box"><p><b>Student:</b> ${esc(s.name)}</p><p><b>Class:</b> ${esc(s.className)}</p></div>
    <div style="margin-top:10px">${rows}</div>
    <div class="total-row">Total: ₹${t.total} &nbsp;|&nbsp; Pending: ₹${t.pending} &nbsp;|&nbsp; Completed: ₹${t.completed}</div>`;
  openPopup('Student Items - '+s.name, body, true);
}
function markCompletedInView(sid,itemId){
  askConfirm('Are you sure you want to mark this as completed?', async ()=>{
    try{ await api('/api/students/'+sid+'/items/'+itemId+'/complete','POST'); showToast('Marked as completed'); await refreshAll(); assignView(sid); }
    catch(e){ showToast(e.message); }
  });
}

function openEditChoice(id){
  currentStudentId = id;
  const body = `<div class="type-choice-grid">
    <div class="type-choice" onclick="openBookAssign('${id}')"><span class="ico">📚</span>Book</div>
    <div class="type-choice" onclick="openUniformAssign('${id}')"><span class="ico">👕</span>Uniform</div>
    <div class="type-choice" onclick="openAccessoriesAssign('${id}')"><span class="ico">🎒</span>Accessories</div>
  </div>`;
  openPopup('Assign Items', body);
}

function statusOptions(prefix,current){
  const cur = current || 'Select';
  return `<option value="Select" ${cur==='Select'?'selected':''}>Select</option>
    <option value="Pending" ${cur==='Pending'?'selected':''}>Pending</option>
    <option value="Completed" ${cur==='Completed'?'selected':''}>Completed</option>`;
}

function openBookAssign(id){
  currentStudentId = id; bookToggleState = false;
  const s = STATE.students.find(x=>x.id===id); if(!s) return;
  const classBooks = STATE.books.filter(b=>b.className===s.className);
  const assignedMap = new Map((s.items||[]).filter(it=>it.type==='book' && it.refId).map(it=>[it.refId,it.status]));
  const rows = classBooks.map(b=>{
    const assignedStatus = assignedMap.get(b.id);
    const checked = assignedMap.has(b.id);
    return `<div class="assign-list-row">
      <input type="checkbox" class="big-check" id="ba-chk-${b.id}" value="${b.id}" ${checked?'checked':''}>
      <span class="name">${esc(b.name)} (₹${b.price})</span>
      <select id="ba-status-${b.id}">${statusOptions('ba',assignedStatus)}</select>
    </div>`;
  }).join('') || '<p style="color:var(--muted)">No books available for this class</p>';
  const body = `<p style="margin-bottom:10px"><b>${esc(s.name)}</b> (${esc(s.className)})</p>
    <div class="row">
      <button class="btn outline small" onclick="baCheckAll()">Check All</button>
      <button class="btn outline small" onclick="baToggleStatus()">Toggle Completed / Pending (for checked)</button>
    </div>
    <div id="ba-rows">${rows}</div>
    <button class="btn big" style="margin-top:14px" onclick="confirmSaveBooks('${id}')">Allot to Student</button>`;
  openPopup('Assign Books', body, true);
}
function baCheckAll(){ document.querySelectorAll('#ba-rows input[type=checkbox]').forEach(c=>c.checked=true); }
function baToggleStatus(){
  bookToggleState = !bookToggleState;
  const target = bookToggleState ? 'Completed' : 'Pending';
  document.querySelectorAll('#ba-rows input[type=checkbox]:checked').forEach(c=>{
    const sel = document.getElementById('ba-status-'+c.value);
    if(sel) sel.value = target;
  });
}
function confirmSaveBooks(id){
  askConfirm('Are you sure you want to save these assignments?', async ()=>{
    const rows = document.querySelectorAll('#ba-rows input[type=checkbox]');
    const bookIds = []; let skipped = 0;
    rows.forEach(c=>{
      if(!c.checked) return;
      const sel = document.getElementById('ba-status-'+c.value);
      if(!sel || sel.value==='Select'){ skipped++; return; }
      bookIds.push({id:c.value, status: sel.value});
    });
    try{
      await api('/api/students/'+id+'/books','POST',{bookIds});
      showToast(skipped ? `Saved. ${skipped} item(s) skipped (status not set)` : 'Books updated');
      await refreshAll(); closePopup(); assignView(id);
    }catch(e){ showToast(e.message); }
  });
}

function openUniformAssign(id){
  currentStudentId = id;
  const s = STATE.students.find(x=>x.id===id); if(!s) return;
  const assignedMap = new Map((s.items||[]).filter(it=>it.type==='uniform').map(it=>[it.category,it]));
  const blocks = UNIFORM_CATEGORIES.map(cat=>{
    const sizesForCat = STATE.uniforms.filter(u=>u.category===cat);
    const assigned = assignedMap.get(cat);
    const checked = !!assigned;
    const sizeOptions = sizesForCat.map(u=>`<option value="${u.id}" ${assigned && assigned.refId===u.id?'selected':''}>${esc(u.size)} (₹${u.price})</option>`).join('');
    return `<div class="uniform-cat-block">
      <h4>${cat}</h4>
      <div class="uniform-cat-row">
        <select id="uf-size-${cat}" ${sizesForCat.length? '' : 'disabled'}>
          <option value="">Select size</option>${sizeOptions}
        </select>
        <input type="checkbox" class="big-check" id="uf-chk-${cat}" ${checked?'checked':''}>
        <select id="uf-status-${cat}">${statusOptions('uf', assigned?assigned.status:null)}</select>
      </div>
      ${sizesForCat.length? '' : '<p style="color:var(--muted);font-size:12px;margin-top:6px">No sizes set up in Inventory for this category yet</p>'}
    </div>`;
  }).join('');
  const body = `<p style="margin-bottom:10px"><b>${esc(s.name)}</b> (${esc(s.className)})</p>
    ${blocks}
    <button class="btn big" style="margin-top:8px" onclick="confirmSaveUniforms('${id}')">Allot to Student</button>`;
  openPopup('Assign Uniform', body, true);
}
function confirmSaveUniforms(id){
  askConfirm('Are you sure you want to save these assignments?', async ()=>{
    const itemIds = []; let skipped = 0;
    UNIFORM_CATEGORIES.forEach(cat=>{
      const chk = document.getElementById('uf-chk-'+cat);
      if(!chk || !chk.checked) return;
      const sizeSel = document.getElementById('uf-size-'+cat);
      const statusSel = document.getElementById('uf-status-'+cat);
      if(!sizeSel || !sizeSel.value || !statusSel || statusSel.value==='Select'){ skipped++; return; }
      itemIds.push({id: sizeSel.value, status: statusSel.value});
    });
    try{
      await api('/api/students/'+id+'/uniforms','POST',{itemIds, categories: UNIFORM_CATEGORIES});
      showToast(skipped ? `Saved. ${skipped} categor${skipped>1?'ies':'y'} skipped (size/status not set)` : 'Uniform items updated');
      await refreshAll(); closePopup(); assignView(id);
    }catch(e){ showToast(e.message); }
  });
}

function openAccessoriesAssign(id){
  currentStudentId = id;
  const s = STATE.students.find(x=>x.id===id); if(!s) return;
  const beltAssigned = (s.items||[]).find(it=>it.type==='uniform' && it.category==='Belt');
  const beltSizes = STATE.uniforms.filter(u=>u.category==='Belt');
  const beltSizeOptions = beltSizes.map(u=>`<option value="${u.id}" ${beltAssigned && beltAssigned.refId===u.id?'selected':''}>${esc(u.size)} (₹${u.price})</option>`).join('');
  const diaryItem = (s.items||[]).find(it=>it.isDiary);
  const body = `<p style="margin-bottom:10px"><b>${esc(s.name)}</b> (${esc(s.className)})</p>
    <div class="uniform-cat-block">
      <h4>Belt</h4>
      <div class="uniform-cat-row">
        <select id="acc-belt-size" ${beltSizes.length?'':'disabled'}>
          <option value="">Select size</option>${beltSizeOptions}
        </select>
        <input type="checkbox" class="big-check" id="acc-belt-chk" ${beltAssigned?'checked':''}>
        <select id="acc-belt-status">${statusOptions('accbelt', beltAssigned?beltAssigned.status:null)}</select>
      </div>
      ${beltSizes.length? '' : '<p style="color:var(--muted);font-size:12px;margin-top:6px">No belt sizes set up in Inventory yet</p>'}
    </div>
    <div class="uniform-cat-block">
      <h4>Diary</h4>
      <div class="uniform-cat-row">
        <input type="checkbox" class="big-check" id="acc-diary-chk" ${diaryItem?'checked':''}>
        <span>₹50</span>
        <select id="acc-diary-status">${statusOptions('accdiary', diaryItem?diaryItem.status:null)}</select>
      </div>
    </div>
    <button class="btn big" style="margin-top:8px" onclick="confirmSaveAccessories('${id}')">Allot to Student</button>`;
  openPopup('Assign Accessories', body, true);
}
function confirmSaveAccessories(id){
  askConfirm('Are you sure you want to save these assignments?', async ()=>{
    let skipped = 0;
    const itemIds = [];
    const beltChk = document.getElementById('acc-belt-chk');
    if(beltChk && beltChk.checked){
      const sizeSel = document.getElementById('acc-belt-size');
      const statusSel = document.getElementById('acc-belt-status');
      if(sizeSel.value && statusSel.value!=='Select') itemIds.push({id:sizeSel.value, status:statusSel.value});
      else skipped++;
    }
    const diaryChk = document.getElementById('acc-diary-chk');
    let diary = { checked:false, status:'Pending' };
    if(diaryChk && diaryChk.checked){
      const statusSel = document.getElementById('acc-diary-status');
      if(statusSel.value!=='Select') diary = { checked:true, status:statusSel.value };
      else skipped++;
    }
    try{
      await api('/api/students/'+id+'/uniforms','POST',{itemIds, categories: ['Belt']});
      await api('/api/students/'+id+'/diary','POST',{diary});
      showToast(skipped ? `Saved. ${skipped} item(s) skipped (size/status not set)` : 'Accessories updated');
      await refreshAll(); closePopup(); assignView(id);
    }catch(e){ showToast(e.message); }
  });
}

