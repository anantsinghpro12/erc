// ---------- INVENTORY: BOOKS ----------
function renderBookInventory(){
  const filter = document.getElementById('ib-filterClass').value;
  const q = (document.getElementById('ib-search').value||'').toLowerCase();
  const list = STATE.books.filter(b => (filter==='All' || b.className===filter) && (!q || b.name.toLowerCase().includes(q) || b.className.toLowerCase().includes(q)));
  document.getElementById('ib-table').innerHTML = list.map(b=>{
    const stockEntry = STATE.bookStock.find(s=>s.bookId===b.id);
    const stockVal = stockEntry ? stockEntry.stock : null;
    const total = stockVal===null?0:stockVal;
    const sold = computeGivenLocal('book', it=>it.refId===b.id);
    const remaining = total - sold;
    return `<tr><td>${esc(b.className)}</td><td>${esc(b.name)}</td><td>₹${b.price}</td><td>${stockVal===null?'Not set':total}</td><td>${sold}</td><td>${stockVal===null?'-':remaining}</td><td>₹${total*b.price}</td><td>₹${sold*b.price}</td>
    <td><button class="btn small" onclick="openStockModal('book','${b.id}',${stockVal===null?'null':stockVal})">${stockVal===null?'Set Stock':'Edit Stock'}</button>
    <button class="btn small danger" onclick="deleteBook('${b.id}')">Delete</button></td></tr>`;
  }).join('') || '<tr><td colspan="9" style="color:var(--muted)">No books found</td></tr>';
}
document.getElementById('ib-filterClass').addEventListener('change', renderBookInventory);
document.getElementById('ib-search').addEventListener('input', renderBookInventory);
async function addBook(){
  const className = document.getElementById('ib-class').value;
  const name = document.getElementById('ib-name').value.trim();
  const price = document.getElementById('ib-price').value;
  if(!name || price===''){ showToast('All fields required'); return; }
  try{ await api('/api/books','POST',{className,name,price}); showToast('Book added'); document.getElementById('ib-name').value=''; document.getElementById('ib-price').value=''; await reloadCatalog(); }
  catch(e){ showToast(e.message); }
}
function deleteBook(id){
  askConfirm('Are you sure you want to delete this book?', async ()=>{
    try{ await api('/api/books/'+id,'DELETE'); showToast('Book deleted'); await reloadCatalog(); }
    catch(e){ showToast(e.message); }
  });
}
function downloadBookTemplate(){ downloadCsv('book_template.csv', 'Class,Book Name,Price\\n5th,Hindi,250\\n5th,English,200\\n5th,Mathematics,300'); }
let parsedBookRows = [];
function parseBookBulk(){
  const raw = document.getElementById('ib-bulkData').value.trim();
  const lines = raw.split('\\n').map(l=>l.trim()).filter(Boolean);
  if(lines.length && /class/i.test(lines[0]) && /book/i.test(lines[0])) lines.shift();
  parsedBookRows = lines.map(l=>{ const [className,name,price] = l.split(',').map(x=>x&&x.trim()); return {className,name,price}; });
  const rows = parsedBookRows.map(r=>{
    const validClass = CLASSES.includes(r.className);
    const validPrice = !isNaN(Number(r.price)) && Number(r.price)>=0;
    const ok = validClass && r.name && validPrice;
    return `<tr style="${ok?'':'color:#c0392b'}"><td>${esc(r.className||'')}</td><td>${esc(r.name||'')}</td><td>${esc(r.price||'')}</td><td>${ok?'Valid':'Invalid'}</td></tr>`;
  }).join('');
  document.getElementById('ib-bulkPreview').innerHTML = `<div class="table-wrap"><table><thead><tr><th>Class</th><th>Name</th><th>Price</th><th>Status</th></tr></thead><tbody>${rows}</tbody></table></div>`;
  document.getElementById('ib-bulkAddBtn').classList.remove('hidden');
}
function confirmAddBooksBulk(){
  askConfirm('Are you sure you want to add these books?', async ()=>{
    try{ const res = await api('/api/books/bulk','POST',{rows:parsedBookRows}); showToast(`Added ${res.added.length} books${res.errors.length?', '+res.errors.length+' errors':''}`); document.getElementById('ib-bulkData').value=''; document.getElementById('ib-bulkPreview').innerHTML=''; document.getElementById('ib-bulkAddBtn').classList.add('hidden'); await reloadCatalog(); }
    catch(e){ showToast(e.message); }
  });
}
function openStockModal(type,id,current){
  const val = prompt('Stock Quantity:', current===null?'':current);
  if(val===null) return;
  const qty = Number(val);
  if(isNaN(qty)||qty<0){ showToast('Invalid stock quantity'); return; }
  askConfirm('Are you sure you want to set stock to '+qty+'?', async ()=>{
    try{
      if(type==='book') await api('/api/stock/book/'+id,'POST',{stock:qty});
      else await api('/api/stock/uniform/'+id,'POST',{stock:qty});
      showToast('Stock updated'); await reloadCatalog();
    }catch(e){ showToast(e.message); }
  });
}

// ---------- INVENTORY: UNIFORMS ----------
function renderIuCatCards(){
  document.getElementById('iu-catCards').innerHTML = CATEGORIES.map(c=>`<div class="uniform-card" onclick="iuOpenCat('${c}')">${c}</div>`).join('');
}
function iuOpenCat(cat){
  currentUniformCat = cat;
  document.getElementById('iu-catTitle').textContent = cat;
  document.getElementById('iu-catCards').classList.add('hidden');
  document.getElementById('iu-catPanel').classList.remove('hidden');
  document.getElementById('iu-search').value='';
  renderIuTable();
}
function iuBack(){ document.getElementById('iu-catCards').classList.remove('hidden'); document.getElementById('iu-catPanel').classList.add('hidden'); }
function renderIuTable(){
  const q = (document.getElementById('iu-search').value||'').toLowerCase();
  const list = STATE.uniforms.filter(u=>u.category===currentUniformCat && (!q || u.size.toLowerCase().includes(q)));
  document.getElementById('iu-table').innerHTML = list.map(u=>{
    const stockEntry = STATE.uniformStock.find(s=>s.itemId===u.id);
    const stockVal = stockEntry ? stockEntry.stock : null;
    const total = stockVal===null?0:stockVal;
    const sold = computeGivenLocal('uniform', it=>it.refId===u.id);
    const remaining = total-sold;
    return `<tr><td>${esc(u.size)}</td><td>₹${u.price}</td><td>${stockVal===null?'Not set':total}</td><td>${sold}</td><td>${stockVal===null?'-':remaining}</td><td>₹${total*u.price}</td><td>₹${sold*u.price}</td>
    <td><button class="btn small" onclick="openStockModal('uniform','${u.id}',${stockVal===null?'null':stockVal})">${stockVal===null?'Set Stock':'Edit Stock'}</button>
    <button class="btn small danger" onclick="deleteUniform('${u.id}')">Delete</button></td></tr>`;
  }).join('') || '<tr><td colspan="8" style="color:var(--muted)">No items found</td></tr>';
}
document.getElementById('iu-search').addEventListener('input', renderIuTable);
async function addUniform(){
  const size = document.getElementById('iu-size').value;
  const price = document.getElementById('iu-price').value;
  if(price===''){ showToast('Price required'); return; }
  try{ await api('/api/uniforms','POST',{category:currentUniformCat,size,price}); showToast('Item added'); document.getElementById('iu-price').value=''; await reloadCatalog(); }
  catch(e){ showToast(e.message); }
}
function deleteUniform(id){
  askConfirm('Are you sure you want to delete this item?', async ()=>{
    try{ await api('/api/uniforms/'+id,'DELETE'); showToast('Item deleted'); await reloadCatalog(); }
    catch(e){ showToast(e.message); }
  });
}
function downloadUniformTemplate(){ downloadCsv('uniform_template.csv', 'Category,Size,Price\\nPants,20,500\\nPants,22,520\\nPants,24,540'); }
let parsedUniformRows = [];
function parseUniformBulk(){
  const raw = document.getElementById('iu-bulkData').value.trim();
  const lines = raw.split('\\n').map(l=>l.trim()).filter(Boolean);
  if(lines.length && /category/i.test(lines[0]) && /size/i.test(lines[0])) lines.shift();
  parsedUniformRows = lines.map(l=>{ const [category,size,price] = l.split(',').map(x=>x&&x.trim()); return {category,size,price}; });
  const rows = parsedUniformRows.map(r=>{
    const validCat = CATEGORIES.includes(r.category);
    const validSize = SIZES.includes(r.size);
    const validPrice = !isNaN(Number(r.price)) && Number(r.price)>=0;
    const ok = validCat && validSize && validPrice;
    return `<tr style="${ok?'':'color:#c0392b'}"><td>${esc(r.category||'')}</td><td>${esc(r.size||'')}</td><td>${esc(r.price||'')}</td><td>${ok?'Valid':'Invalid'}</td></tr>`;
  }).join('');
  document.getElementById('iu-bulkPreview').innerHTML = `<div class="table-wrap"><table><thead><tr><th>Category</th><th>Size</th><th>Price</th><th>Status</th></tr></thead><tbody>${rows}</tbody></table></div>`;
  document.getElementById('iu-bulkAddBtn').classList.remove('hidden');
}
function confirmAddUniformsBulk(){
  askConfirm('Are you sure you want to add these uniform items?', async ()=>{
    try{ const res = await api('/api/uniforms/bulk','POST',{rows:parsedUniformRows}); showToast(`Added ${res.added.length} items${res.errors.length?', '+res.errors.length+' errors':''}`); document.getElementById('iu-bulkData').value=''; document.getElementById('iu-bulkPreview').innerHTML=''; document.getElementById('iu-bulkAddBtn').classList.add('hidden'); await reloadCatalog(); }
    catch(e){ showToast(e.message); }
  });
}
function downloadCsv(filename, content){
  const blob = new Blob([content], {type:'text/csv'});
  const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = filename; a.click();
}

// ---------- REMAINING STOCKS ----------
function rmBack(){
  document.getElementById('rm-booksPanel').classList.add('hidden');
  document.getElementById('rm-uniformCatPanel').classList.add('hidden');
  document.getElementById('rm-uniformSizePanel').classList.add('hidden');
}
let allRemainingBooks = [];
async function showRemainingBooks(){
  rmBack();
  allRemainingBooks = await api('/api/remaining/books');
  document.getElementById('rm-bookSearch').value='';
  renderRemainingBooksTable();
  document.getElementById('rm-booksPanel').classList.remove('hidden');
}
function renderRemainingBooksTable(){
  const q = (document.getElementById('rm-bookSearch').value||'').toLowerCase();
  const list = allRemainingBooks.filter(b => !q || b.name.toLowerCase().includes(q) || b.className.toLowerCase().includes(q));
  document.getElementById('rm-booksTable').innerHTML = list.map(b=>`<tr><td>${esc(b.name)}</td><td>${esc(b.className)}</td><td>₹${b.price}</td><td>${b.total}</td><td>${b.given}</td><td>${b.remaining}</td><td>₹${b.total*b.price}</td><td>₹${b.given*b.price}</td></tr>`).join('') || '<tr><td colspan="8" style="color:var(--muted)">No books found</td></tr>';
}
document.getElementById('rm-bookSearch').addEventListener('input', renderRemainingBooksTable);
function showRemainingUniforms(){
  rmBack();
  document.getElementById('rm-uniformCards').innerHTML = CATEGORIES.map(c=>`<div class="uniform-card" onclick="showRemainingUniformCat('${c}')">${c}</div>`).join('');
  document.getElementById('rm-uniformCatPanel').classList.remove('hidden');
}
let allRemainingUniformSizes = [];
async function showRemainingUniformCat(cat){
  allRemainingUniformSizes = await api('/api/remaining/uniforms/'+encodeURIComponent(cat));
  document.getElementById('rm-uniformCatTitle').textContent = 'Remaining Stock - '+cat;
  document.getElementById('rm-sizeSearch').value='';
  renderRemainingUniformSizeTable();
  document.getElementById('rm-uniformCatPanel').classList.add('hidden');
  document.getElementById('rm-uniformSizePanel').classList.remove('hidden');
}
function renderRemainingUniformSizeTable(){
  const q = (document.getElementById('rm-sizeSearch').value||'').toLowerCase();
  const list = allRemainingUniformSizes.filter(u=>!q || u.size.toLowerCase().includes(q));
  document.getElementById('rm-uniformSizeTable').innerHTML = list.map(u=>`<tr><td>${esc(u.size)}</td><td>₹${u.price}</td><td>${u.total}</td><td>${u.given}</td><td>${u.remaining}</td><td>₹${u.total*u.price}</td><td>₹${u.given*u.price}</td></tr>`).join('') || '<tr><td colspan="7" style="color:var(--muted)">No items found</td></tr>';
}
document.getElementById('rm-sizeSearch').addEventListener('input', renderRemainingUniformSizeTable);

// initial render
renderDashboard(); renderStudentTable(); renderAsTable(); renderPayTable(); renderBookInventory(); renderIuCatCards();
</script>
